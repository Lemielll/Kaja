# =============================================================================
# Heavy Equipment Rental Service - Environment Configuration
# File: service/.env.example
# Description: Template for environment variables required by the service.
# Copy this file to .env and adjust the values according to your environment.
# =============================================================================

# HTTP Port the server will listen on
PORT=4010

# Environment mode: 'development', 'production', or 'test'
NODE_ENV=development

# PostgreSQL Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Local Docker example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/heavy_rental

# Cloud Provider examples (Render / Neon):
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/heavy_rental?sslmode=require

# =============================================================================
# OpenID Connect Configuration (Session 4 — Authentication)
# =============================================================================

# OIDC Issuer URL (from authorization server's discovery document)
# Example for Keycloak: http://localhost:8080/realms/kaja
OIDC_ISSUER=

# OIDC JWKS URI (public key endpoint for token verification)
# Example for Keycloak: http://localhost:8080/realms/kaja/protocol/openid-connect/certs
OIDC_JWKS_URI=

# Expected audience in access token (prevents token from other APIs being accepted)
# Should match the client_id or resource identifier configured in authorization server
OIDC_AUDIENCE=kaja-api